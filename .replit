modules = ["python-base-3.13"]
[nix]
channel = "stable-25_05"
packages = ["cairo", "ffmpeg-full", "freetype", "geckodriver", "ghostscript", "glibcLocales", "gobject-introspection", "gtk3", "libxcrypt", "pkg-config", "qhull", "tcl", "tk"]

[deployment]
run = ["python", "main.py"]

[languages.python3]
pattern = "**/*.py"

[languages.python3.languageServer]
start = "pylsp"
