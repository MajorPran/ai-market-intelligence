# AI Market Intelligence Tool - Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# LLM API KEYS (Get free tiers from providers)
# =============================================================================

# OpenAI API (Free tier: $18 credit for new accounts)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic API (Free tier available) 
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Hugging Face API (Free tier with rate limits)
# Get from: https://huggingface.co/settings/tokens  
HUGGINGFACE_API_KEY=hf_your-huggingface-token-here

# =============================================================================
# LLM CONFIGURATION
# =============================================================================

# Primary model to use (gpt-3.5-turbo, claude-3-haiku-20240307, etc.)
DEFAULT_MODEL=gpt-3.5-turbo

# Token limits and creativity settings
MAX_TOKENS=2000
TEMPERATURE=0.3

# =============================================================================
# DATABASE SETTINGS
# =============================================================================

# SQLite for development (no setup required)
DATABASE_URL=sqlite:///./data/intelligence.db

# PostgreSQL for production (optional)
# DATABASE_URL=postgresql://user:password@localhost:5432/intelligence

# =============================================================================
# WEB SCRAPING CONFIGURATION  
# =============================================================================

# User agent for web requests
USER_AGENT=Mozilla/5.0 (compatible; AIIntelligence/1.0; +https://yoursite.com)

# Rate limiting to be respectful
REQUEST_DELAY=2.0
MAX_RETRIES=3
TIMEOUT=30
CONCURRENT_REQUESTS=5

# Content filtering
MAX_CONTENT_LENGTH=10000
MIN_CONTENT_LENGTH=100

# =============================================================================
# TARGET SOURCES (Comma-separated URLs)
# =============================================================================

# News sources to monitor
NEWS_SOURCES=https://techcrunch.com,https://venturebeat.com,https://www.theverge.com,https://arstechnica.com

# Keywords to track
MONITORING_KEYWORDS=artificial intelligence,machine learning,AI startup,venture capital,tech innovation

# =============================================================================
# VECTOR EMBEDDINGS SETTINGS
# =============================================================================

# Embedding model (sentence-transformers models work offline)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DIMENSION=384
SIMILARITY_THRESHOLD=0.8

# =============================================================================
# EMAIL ALERTS (Optional)
# =============================================================================

# SMTP settings for alerts
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Gmail app password (not your regular password!)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_USER=your.email@gmail.com
EMAIL_PASSWORD=your-app-specific-password

# =============================================================================
# WEBHOOK ALERTS (Optional)
# =============================================================================

# Slack webhook, Discord webhook, etc.
WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# =============================================================================
# SCHEDULING CONFIGURATION
# =============================================================================

# How often to scrape (hours)
SCRAPE_INTERVAL_HOURS=6

# How often to generate reports (hours)
REPORT_INTERVAL_HOURS=24

# How long to keep old data (days)
CLEANUP_INTERVAL_DAYS=30

# =============================================================================
# API SERVER SETTINGS
# =============================================================================

# FastAPI server configuration
API_HOST=0.0.0.0
API_PORT=8000

# Security settings
SECRET_KEY=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Enable debug mode (more verbose logging)
DEBUG=True

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Performance settings
CACHE_TTL_SECONDS=3600
MAX_MEMORY_USAGE_MB=1024

# =============================================================================
# REPORT CONFIGURATION
# =============================================================================

# Output formats for reports (comma-separated)
OUTPUT_FORMATS=html,pdf,json

# =============================================================================
# FREE TIER OPTIMIZATION
# =============================================================================

# Reduced settings for free API tiers
# MAX_TOKENS=1000
# REQUEST_DELAY=3.0
# CONCURRENT_REQUESTS=2
# SCRAPE_INTERVAL_HOURS=12